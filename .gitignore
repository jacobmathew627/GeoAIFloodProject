# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
venv*/
.venv/
env/

# Large data files (use Git LFS for these)
# GeoAI_New/*.tif   <-- tracked via Git LFS
# outputs/*.tif     <-- tracked via Git LFS
*.aux.xml
*.lck

# Models (large binaries - use Git LFS)
# models/*.pth
# models/*.h5

# Scratch test scripts at the repo root only.
# NOTE: this pattern used to be `test_*.py`, which is unanchored and so also
# matched tests/test_*.py -- the entire test suite was untracked while CI ran
# `pytest tests/` against a directory that contained nothing.
/test_*.py
*.log
*.tmp
sentinel_data/

# Archive and processed intermediates
archive/
processed/
GeoAI_Data/

# Build artefacts from align_data.py (~2.6 GB, fully regenerable).
data_aligned/

# Model artefacts produced by src/susceptibility.py
models/susceptibility_model.joblib

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Derived model rasters (regenerable: susceptibility.py --predict, hazard.py)
outputs/susceptibility*.tif
outputs/conformal_sets.tif
outputs/flood_hazard_*.tif

# Live model cache (regenerable: python src/live_model.py --build)
models/live_model.npz

# Upstream DEM mosaic (regenerable: python src/upstream_dem.py --build)
GeoAI_New/Upstream_DEM.tif

# IMD rainfall cache (regenerable via imdlib)
data/imd_rain/
models/rainfall_forecast.joblib

# Acquired flood inventories (regenerable: src/acquire_flood_event.py)
GeoAI_New/Flood_Extent_*.tif

# NDEM inventory cache (regenerable: src/ndem_labels.py)
data/ndem/

# OSM drainage cache (regenerable: python src/osm_drainage.py --build)
data/osm/

# WorldPop population cache (regenerable: python src/population.py --project <id>)
data/worldpop/

# Upstream-routing scratch DEM -- a working copy of the already-gitignored
# GeoAI_New/Upstream_DEM.tif, kept by src/upstream_routing.py's WORK_DIR as a
# cache so a rerun does not repeat the ~70-90 min depression-breaching step.
# The routing itself is finished and committed (data_aligned/flow_aligned.tif);
# this is just its scratch input.
GeoAI_New/routing_work/

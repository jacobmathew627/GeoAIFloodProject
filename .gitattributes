*.tif filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

# Deployment carve-out: these specific rasters are stored as ordinary git
# blobs, NOT LFS.
#
# Streamlit Community Cloud clones the repository without resolving Git LFS, so
# an LFS-tracked raster arrives as a ~130-byte pointer file. rasterio would then
# fail to open it and every static layer would break, with an error that looks
# like raster corruption rather than a checkout problem.
#
# These are the runtime artefacts the deployed dashboard reads, and together
# they are ~25 MB -- comfortably inside GitHub's 100 MB per-file limit and small
# enough that plain blobs cost nothing meaningful. Later rules win in
# .gitattributes, so these override the `*.tif` line above.
#
# The full-resolution rasters in GeoAI_New/ stay on LFS; they are hundreds of MB
# each and are not deployed.
display/*.tif -filter -diff -merge -text
outputs/conformal_sets.tif -filter -diff -merge -text
